<Page
    x:Class="ShiftControl.App.Views.DisksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ShiftControl.App.Services"
    xmlns:v="using:ShiftControl.App.Views"
    NavigationCacheMode="Required"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20" MaxWidth="1100" HorizontalAlignment="Left">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="{l:Tr Key=nav.group.hardware, Upper=True}" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="{l:Tr Key=nav.disks}" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="{l:Tr Key=disks.subtitle}" Style="{StaticResource CaptionText}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                    <ProgressRing IsActive="{x:Bind Vm.Busy, Mode=OneWay}" Width="16" Height="16" />
                    <Button Style="{StaticResource QuietButton}" Content="{l:Tr Key=common.refresh}" Command="{x:Bind Vm.LoadCommand}" IsEnabled="{x:Bind v:ViewHelpers.Not(Vm.Busy), Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <InfoBar IsOpen="{x:Bind v:ViewHelpers.HasText(Vm.Message), Mode=OneWay}" IsClosable="True" Message="{x:Bind Vm.Message, Mode=OneWay}"
                     Severity="{x:Bind v:SettingsPage.StatusSeverity(Vm.MessageIsError), Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind Vm.CountersMissing, Mode=OneWay}" IsClosable="False" Severity="Informational" Message="{l:Tr Key=disks.countersMissing}" />

            <StackPanel Spacing="8">
                <TextBlock Text="{l:Tr Key=disks.physical}" Style="{StaticResource SectionTitleText}" />
                <Border Style="{StaticResource CardBorder}" Padding="0">
                    <Grid>
                        <ItemsRepeater ItemsSource="{x:Bind Vm.Disks}" ItemTemplate="{StaticResource RowTemplate}" />
                        <TextBlock Text="{l:Tr Key=common.loading}" Style="{StaticResource SecondaryText}" Margin="16,14" Visibility="{x:Bind v:ViewHelpers.Collapsed(Vm.Loaded), Mode=OneWay}" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="{l:Tr Key=disks.volumes}" Style="{StaticResource SectionTitleText}" />
                <Border Style="{StaticResource CardBorder}" Padding="0">
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Volumes}" ItemTemplate="{StaticResource RowTemplate}" />
                </Border>
                <TextBlock Text="{l:Tr Key=disks.alertHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
