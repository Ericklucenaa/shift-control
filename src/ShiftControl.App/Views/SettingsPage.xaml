<Page
    x:Class="ShiftControl.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ShiftControl.App.Services"
    xmlns:vm="using:ShiftControl.App.ViewModels"
    xmlns:v="using:ShiftControl.App.Views"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="ColumnSpacing" Value="24" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Padding" Value="0,10" />
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SettingHint" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="SettingControl" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20" MaxWidth="920" HorizontalAlignment="Left">
            <StackPanel Spacing="2">
                <TextBlock Text="{l:Tr Key=nav.group.system, Upper=True}" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="{l:Tr Key=nav.settings}" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{l:Tr Key=settings.subtitle}" Style="{StaticResource CaptionText}" FontSize="13" />
            </StackPanel>

            <InfoBar IsOpen="{x:Bind v:ViewHelpers.HasText(Vm.StatusMessage), Mode=OneWay}" IsClosable="True"
                     Message="{x:Bind Vm.StatusMessage, Mode=OneWay}"
                     Severity="{x:Bind v:SettingsPage.StatusSeverity(Vm.StatusIsError), Mode=OneWay}" />

            <!-- Aparência -->
            <StackPanel Spacing="8">
                <TextBlock Text="{l:Tr Key=settings.appearance}" Style="{StaticResource SectionTitleText}" />
                <Border Style="{StaticResource CardBorder}" Padding="20,6">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{l:Tr Key=settings.theme}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{l:Tr Key=settings.themeHint}" Style="{StaticResource SettingHint}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource SettingControl}" ItemsSource="{x:Bind Vm.Themes}"
                                      SelectedItem="{x:Bind Vm.Theme, Mode=TwoWay}" AutomationProperties.Name="{l:Tr Key=settings.theme}" />
                        </Grid>
                        <Rectangle Style="{StaticResource DividerLine}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{l:Tr Key=settings.language}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{l:Tr Key=settings.languageHint}" Style="{StaticResource SettingHint}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource SettingControl}" ItemsSource="{x:Bind Vm.Languages}"
                                      SelectedItem="{x:Bind Vm.Language, Mode=TwoWay}" AutomationProperties.Name="{l:Tr Key=settings.language}" />
                        </Grid>
                        <Rectangle Style="{StaticResource DividerLine}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{l:Tr Key=settings.accent}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{l:Tr Key=settings.accentHint}" Style="{StaticResource SettingHint}" />
                            </StackPanel>
                            <GridView Grid.Column="1" ItemsSource="{x:Bind Vm.Accents}" SelectedItem="{x:Bind Vm.Accent, Mode=TwoWay}"
                                      SelectionMode="Single" VerticalAlignment="Center" Padding="0" ScrollViewer.HorizontalScrollMode="Disabled"
                                      AutomationProperties.Name="{l:Tr Key=settings.accent}">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AccentChoice">
                                        <Ellipse Width="20" Height="20" Margin="4" ToolTipService.ToolTip="{x:Bind Label}"
                                                 AutomationProperties.Name="{x:Bind Label}">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{x:Bind Color}" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </Grid>
                        <Rectangle Style="{StaticResource DividerLine}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{l:Tr Key=settings.unit}" Style="{StaticResource SettingLabel}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource SettingControl}" ItemsSource="{x:Bind Vm.Units}"
                                      SelectedItem="{x:Bind Vm.Unit, Mode=TwoWay}" AutomationProperties.Name="{l:Tr Key=settings.unit}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Monitoramento e histórico -->
            <StackPanel Spacing="8">
                <TextBlock Text="{l:Tr Key=appearance.title}" Style="{StaticResource SectionTitleText}" />
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{l:Tr Key=appearance.hint}" Style="{StaticResource SecondaryText}" />
                        <ComboBox Header="{l:Tr Key=appearance.palette}" AutomationProperties.Name="{l:Tr Key=appearance.palette}"
                                  HorizontalAlignment="Stretch" ItemsSource="{x:Bind Vm.VisualThemes}" SelectedItem="{x:Bind Vm.VisualTheme, Mode=TwoWay}" />
                        <ComboBox Header="{l:Tr Key=appearance.buttons}" AutomationProperties.Name="{l:Tr Key=appearance.buttons}"
                                  HorizontalAlignment="Stretch" ItemsSource="{x:Bind Vm.ButtonLooks}" SelectedItem="{x:Bind Vm.ButtonLook, Mode=TwoWay}" />
                        <TextBlock Text="{l:Tr Key=appearance.preview}" Style="{StaticResource CaptionText}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="{l:Tr Key=appearance.primary}" Style="{StaticResource PrimaryButton}" />
                            <Button Content="{l:Tr Key=appearance.secondary}" Style="{StaticResource QuietButton}" />
                            <Button Content="{l:Tr Key=appearance.disabled}" Style="{StaticResource QuietButton}" IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Monitoramento e histórico -->
            <StackPanel Spacing="8">
                <TextBlock Text="{l:Tr Key=settings.monitoring}" Style="{StaticResource SectionTitleText}" />
                <Border Style="{StaticResource CardBorder}" Padding="20,6">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{l:Tr Key=settings.interval}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{l:Tr Key=settings.intervalHint}" Style="{StaticResource SettingHint}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource SettingControl}" ItemsSource="{x:Bind Vm.Intervals}"
                                      SelectedItem="{x:Bind Vm.Interval, Mode=TwoWay}" AutomationProperties.Name="{l:Tr Key=settings.interval}" />
                        </Grid>
                        <Rectangle Style="{StaticResource DividerLine}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{l:Tr Key=settings.record}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{l:Tr Key=settings.recordHint}" Style="{StaticResource SettingHint}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Vm.RecordHistory, Mode=TwoWay}" OnContent="" OffContent=""
                                          MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="{l:Tr Key=settings.record}" />
                        </Grid>
                        <Rectangle Style="{StaticResource DividerLine}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{l:Tr Key=settings.rawRetention}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{l:Tr Key=settings.rawRetentionHint}" Style="{StaticResource SettingHint}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource SettingControl}" ItemsSource="{x:Bind Vm.RawRetentions}"
                                      SelectedItem="{x:Bind Vm.RawRetention, Mode=TwoWay}" AutomationProperties.Name="{l:Tr Key=settings.rawRetention}" />
                        </Grid>
                        <Rectangle Style="{StaticResource DividerLine}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{l:Tr Key=settings.aggRetention}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{l:Tr Key=settings.aggRetentionHint}" Style="{StaticResource SettingHint}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource SettingControl}" ItemsSource="{x:Bind Vm.AggregatedRetentions}"
                                      SelectedItem="{x:Bind Vm.AggregatedRetention, Mode=TwoWay}" AutomationProperties.Name="{l:Tr Key=settings.aggRetention}" />
                        </Grid>
                        <Rectangle Style="{StaticResource DividerLine}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{l:Tr Key=settings.database}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Style="{StaticResource SettingHint}">
                                    <Run Text="{l:Tr Key=settings.databaseSize}" /> <Run Text="{x:Bind Vm.DatabaseSize, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource QuietButton}" Content="{l:Tr Key=settings.clearHistory}"
                                    Click="OnClearHistory" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Inicialização -->
            <StackPanel Spacing="8">
                <TextBlock Text="{l:Tr Key=settings.startup}" Style="{StaticResource SectionTitleText}" />
                <Border Style="{StaticResource CardBorder}" Padding="20,6">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{l:Tr Key=settings.startWithWindows}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{l:Tr Key=settings.startWithWindowsHint}" Style="{StaticResource SettingHint}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Vm.StartWithWindows, Mode=TwoWay}" OnContent="" OffContent=""
                                          MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="{l:Tr Key=settings.startWithWindows}" />
                        </Grid>
                        <Rectangle Style="{StaticResource DividerLine}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{l:Tr Key=settings.startMinimized}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{l:Tr Key=settings.startMinimizedHint}" Style="{StaticResource SettingHint}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Vm.StartMinimized, Mode=TwoWay}" OnContent="" OffContent=""
                                          MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="{l:Tr Key=settings.startMinimized}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="{l:Tr Key=settings.trayUpdates}" Style="{StaticResource SectionTitleText}" />
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="12">
                        <ToggleSwitch Header="{l:Tr Key=settings.closeToTray}" IsOn="{x:Bind Vm.CloseToTray, Mode=TwoWay}" />
                        <ToggleSwitch Header="{l:Tr Key=settings.checkUpdates}" IsOn="{x:Bind Vm.CheckUpdates, Mode=TwoWay}" />
                        <ToggleSwitch Header="{l:Tr Key=settings.autoInstallUpdates}" IsOn="{x:Bind Vm.AutoInstallUpdates, Mode=TwoWay}" />
                        <TextBlock Text="{l:Tr Key=update.autoDescription}" TextWrapping="Wrap" Style="{StaticResource CaptionText}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="{l:Tr Key=update.check}" Command="{x:Bind Vm.CheckForUpdatesCommand}" IsEnabled="{x:Bind v:ViewHelpers.Not(Vm.CheckingUpdate), Mode=OneWay}" />
                            <Button Content="{l:Tr Key=update.install}" Click="OnInstallUpdate" IsEnabled="{x:Bind Vm.CanInstallUpdate, Mode=OneWay}" />
                            <ProgressRing Width="20" Height="20" IsActive="{x:Bind Vm.CheckingUpdate, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Vm.UpdateStatus, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Privacidade e sobre -->
            <StackPanel Spacing="8">
                <TextBlock Text="{l:Tr Key=settings.privacy}" Style="{StaticResource SectionTitleText}" />
                <Border Style="{StaticResource CardBorder}" Padding="20,6">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{l:Tr Key=settings.localOnly}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="{x:Bind Vm.DataFolder}" Style="{StaticResource SettingHint}" IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Style="{StaticResource QuietButton}" Content="{l:Tr Key=settings.openData}" Command="{x:Bind Vm.OpenDataFolderCommand}" />
                                <Button Style="{StaticResource QuietButton}" Content="{l:Tr Key=settings.openLogs}" Command="{x:Bind Vm.OpenLogsCommand}" />
                            </StackPanel>
                        </Grid>
                        <Rectangle Style="{StaticResource DividerLine}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{l:Tr Key=settings.sensorAccess}" Style="{StaticResource SettingLabel}" />
                                <TextBlock Style="{StaticResource SettingHint}">
                                    <Run Text="{x:Bind Vm.ModeText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{x:Bind Vm.DriverText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource QuietButton}" Content="{l:Tr Key=dashboard.driverLink}"
                                    Command="{x:Bind Vm.OpenDriverSiteCommand}" VerticalAlignment="Center" />
                        </Grid>
                        <Rectangle Style="{StaticResource DividerLine}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Shift Control" Style="{StaticResource SettingLabel}" />
                                <TextBlock Style="{StaticResource SettingHint}">
                                    <Run Text="{l:Tr Key=settings.version}" /> <Run Text="{x:Bind Vm.Version}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
