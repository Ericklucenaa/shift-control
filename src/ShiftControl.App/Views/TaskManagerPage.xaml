<Page
    x:Class="ShiftControl.App.Views.TaskManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ShiftControl.App.Services"
    xmlns:v="using:ShiftControl.App.Views"
    xmlns:vm="using:ShiftControl.App.ViewModels"
    NavigationCacheMode="Required" Background="Transparent">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12" MaxWidth="1600">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="2">
            <TextBlock Text="{l:Tr Key=nav.group.system, Upper=True}" Style="{StaticResource EyebrowText}" />
            <TextBlock Text="{l:Tr Key=nav.tasks}" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{l:Tr Key=tasks.subtitle}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" />
        </StackPanel>
        <InfoBar Grid.Row="1" IsOpen="{x:Bind v:ViewHelpers.HasText(Vm.Message), Mode=OneWay}" IsClosable="True"
                 Message="{x:Bind Vm.Message, Mode=OneWay}" Severity="{x:Bind v:SettingsPage.StatusSeverity(Vm.MessageIsError), Mode=OneWay}" />
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16,12">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="CPU" Style="{StaticResource CaptionText}" /><TextBlock Text="{x:Bind Vm.CpuTotal, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" /></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="{l:Tr Key=tasks.memory}" Style="{StaticResource CaptionText}" /><TextBlock Text="{x:Bind Vm.MemoryTotal, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="{l:Tr Key=tasks.processes}" Style="{StaticResource CaptionText}" /><TextBlock Text="{x:Bind Vm.ProcessCount, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" /></StackPanel>
            </Grid>
        </Border>
        <StackPanel Grid.Row="3" Spacing="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="165" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox Text="{x:Bind Vm.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Tr Key=tasks.search}"
                         AutomationProperties.AutomationId="tasks.search" AutomationProperties.Name="{l:Tr Key=tasks.search}" />
                <ComboBox Grid.Column="1" ItemsSource="{x:Bind Vm.SortOptions}" SelectedItem="{x:Bind Vm.Sort, Mode=TwoWay}" HorizontalAlignment="Stretch"
                          AutomationProperties.AutomationId="tasks.sort" AutomationProperties.Name="{l:Tr Key=tasks.sortLabel}" />
                <Button Grid.Column="2" Content="{l:Tr Key=common.refresh}" Command="{x:Bind Vm.RefreshCommand}" Style="{StaticResource QuietButton}" AutomationProperties.AutomationId="tasks.refresh" />
                <Button Grid.Column="3" Content="{l:Tr Key=tasks.end}" Style="{StaticResource PrimaryButton}" Click="OnEndProcess"
                        IsEnabled="{x:Bind Vm.CanEnd, Mode=OneWay}" AutomationProperties.AutomationId="tasks.end" />
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <CheckBox Content="{l:Tr Key=tasks.groupByName}" IsChecked="{x:Bind Vm.GroupByName, Mode=TwoWay}" AutomationProperties.AutomationId="tasks.groupByName" />
                <CheckBox Grid.Column="1" Content="{l:Tr Key=tasks.appsOnly}" IsChecked="{x:Bind Vm.AppsOnly, Mode=TwoWay}" AutomationProperties.AutomationId="tasks.appsOnly" />
                <CheckBox Grid.Column="2" Content="{l:Tr Key=tasks.pause}" IsChecked="{x:Bind Vm.Paused, Mode=TwoWay}" AutomationProperties.AutomationId="tasks.pause" />
            </Grid>
            <TextBlock Text="{x:Bind Vm.SelectionHint, Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" />
        </StackPanel>
        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Padding="24,10" ColumnSpacing="10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardBorderBrush}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="100" /><ColumnDefinition Width="60" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{l:Tr Key=tasks.name}" Style="{StaticResource CaptionText}" />
                    <TextBlock Grid.Column="1" Text="CPU" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="{l:Tr Key=tasks.memory}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="PID" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="{l:Tr Key=tasks.state}" Style="{StaticResource CaptionText}" />
                </Grid>
                <ListView x:Name="ProcessList" Grid.Row="1" ItemsSource="{x:Bind Vm.Processes}" SelectedItem="{x:Bind Vm.SelectedProcess, Mode=TwoWay}" ContextRequested="OnProcessContextRequested"
                          SelectionMode="Single" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="tasks.list">
                    <ListView.KeyboardAccelerators><KeyboardAccelerator Key="Delete" Invoked="OnEndKeyInvoked" /></ListView.KeyboardAccelerators>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaskProcessVm">
                            <Grid Padding="8,9" ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="100" /><ColumnDefinition Width="60" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind CpuText, Mode=OneWay}" Style="{StaticResource MetricValueText}" FontWeight="Normal" />
                                <TextBlock Grid.Column="2" Text="{x:Bind MemoryText, Mode=OneWay}" Style="{StaticResource MetricValueText}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind PidText, Mode=OneWay}" Style="{StaticResource MetricValueText}" FontWeight="Normal" Foreground="{ThemeResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind StateText, Mode=OneWay}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind v:ViewHelpers.Visible(Vm.Empty), Mode=OneWay}">
                    <TextBlock Text="{l:Tr Key=tasks.empty}" Style="{StaticResource SecondaryText}" />
                </StackPanel>
                <ProgressRing Grid.Row="1" IsActive="{x:Bind Vm.Busy, Mode=OneWay}" Width="28" Height="28" Visibility="{x:Bind v:ViewHelpers.Visible(Vm.Busy), Mode=OneWay}" />
                <Grid Grid.Row="2" Padding="16,8" ColumnSpacing="16" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardBorderBrush}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Vm.Summary, Mode=OneWay}" Style="{StaticResource CaptionText}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Vm.UpdatedAt, Mode=OneWay}" Style="{StaticResource CaptionText}" AutomationProperties.AutomationId="tasks.updated" />
                </Grid>
            </Grid>
        </Border>
        <StackPanel Grid.Row="5" Spacing="8">
            <TextBlock Text="{l:Tr Key=tasks.hint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" />
            <Grid ColumnSpacing="12" Visibility="{x:Bind v:ViewHelpers.Visible(Vm.HasSelection), Mode=OneWay}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Vm.SelectedProcess.DisplayName, Mode=OneWay}" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="{l:Tr Key=tasks.details}" Style="{StaticResource QuietButton}" VerticalAlignment="Center" AutomationProperties.AutomationId="tasks.details">
                    <Button.Flyout>
                        <Flyout>
                            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="8" Width="360">
                                    <TextBlock Text="{x:Bind Vm.SelectedProcess.Name, Mode=OneWay}" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="{l:Tr Key=tasks.path}" Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="{x:Bind Vm.ExecutablePath, Mode=OneWay}" Style="{StaticResource BodyText}" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{x:Bind Vm.Publisher, Mode=OneWay}" Style="{StaticResource SecondaryText}" />
                                    <TextBlock Text="{l:Tr Key=tasks.started}" Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="{x:Bind Vm.StartedAt, Mode=OneWay}" Style="{StaticResource BodyText}" />
                                    <TextBlock Text="{l:Tr Key=tasks.threads}" Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="{x:Bind Vm.SelectedProcess.ThreadsText, Mode=OneWay}" Style="{StaticResource BodyText}" />
                                    <TextBlock Text="{l:Tr Key=tasks.privateMemory}" Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="{x:Bind Vm.SelectedProcess.PrivateText, Mode=OneWay}" Style="{StaticResource BodyText}" />
                                    <Button Content="{l:Tr Key=tasks.reveal}" Command="{x:Bind Vm.RevealCommand}" Style="{StaticResource QuietButton}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</Page>
