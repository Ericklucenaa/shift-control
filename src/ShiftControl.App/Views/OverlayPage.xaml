<Page
    x:Class="ShiftControl.App.Views.OverlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ShiftControl.App.Services"
    xmlns:vm="using:ShiftControl.App.ViewModels"
    xmlns:v="using:ShiftControl.App.Views"
    xmlns:ov="using:ShiftControl.App.Overlay"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="ColumnSpacing" Value="20" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="0,8" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <DataTemplate x:Key="SwatchTemplate" x:DataType="vm:ColorChoice">
            <Ellipse Width="18" Height="18" Margin="3" ToolTipService.ToolTip="{x:Bind Label}" AutomationProperties.Name="{x:Bind Label}"
                     Stroke="{ThemeResource CardBorderBrush}" StrokeThickness="1">
                <Ellipse.Fill>
                    <SolidColorBrush Color="{x:Bind Color}" />
                </Ellipse.Fill>
            </Ellipse>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <StackPanel Orientation="Horizontal" Spacing="2" />
        </ItemsPanelTemplate>
    </Page.Resources>

    <Grid>
    <ScrollViewer x:Name="PageScroll" ViewChanged="OnPageScrolled" VerticalScrollBarVisibility="Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1240" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SideColumn.Width" Value="0" />
                        <Setter Target="Side.(Grid.Column)" Value="0" />
                        <Setter Target="Side.(Grid.Row)" Value="0" />
                        <Setter Target="Main.(Grid.Row)" Value="1" />
                        <Setter Target="Side.Margin" Value="0,0,0,20" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20" MaxWidth="1500">
            <!-- Cabeçalho -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="{l:Tr Key=nav.group.gaming, Upper=True}" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="{l:Tr Key=nav.overlay}" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="{l:Tr Key=overlay.subtitle}" Style="{StaticResource CaptionText}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{l:Tr Key=overlay.enable}" VerticalAlignment="Center" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                    <ToggleSwitch IsOn="{x:Bind Vm.Enabled, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                  AutomationProperties.Name="{l:Tr Key=overlay.enable}" />
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SideColumn" Width="400" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Coluna principal: configurações -->
                <StackPanel x:Name="Main" Spacing="20">

                    <!-- Captura de FPS -->
                    <Border Style="{StaticResource CardBorder}">
                        <Grid ColumnSpacing="14" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="9" Height="9" VerticalAlignment="Top" Margin="0,6,0,0"
                                     Fill="{x:Bind CaptureBrush(Vm.CaptureOk), Mode=OneWay}" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{x:Bind Vm.CaptureTitle, Mode=OneWay}" Style="{StaticResource SectionTitleText}" FontSize="14" />
                                <TextBlock Text="{x:Bind Vm.CaptureMessage, Mode=OneWay}" Style="{StaticResource SecondaryText}" IsTextSelectionEnabled="True" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0"
                                            Visibility="{x:Bind v:ViewHelpers.Visible(Vm.ShowGrant), Mode=OneWay}">
                                    <Button Style="{StaticResource PrimaryButton}" Content="{l:Tr Key=overlay.capture.grant}" Click="OnGrant" />
                                    <Button Style="{StaticResource QuietButton}" Content="{l:Tr Key=dashboard.restartAdmin}" Command="{x:Bind Vm.RestartAsAdminCommand}" />
                                </StackPanel>
                                <Button Style="{StaticResource QuietButton}" Content="{l:Tr Key=overlay.capture.retry}" Margin="0,6,0,0"
                                        Command="{x:Bind Vm.RetryCaptureCommand}" Visibility="{x:Bind v:ViewHelpers.Visible(Vm.ShowRetry), Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Preset -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{l:Tr Key=overlay.presets}" Style="{StaticResource SectionTitleText}" />
                        <Border Style="{StaticResource CardBorder}" Padding="20,6">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{l:Tr Key=overlay.preset}" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="{l:Tr Key=overlay.presetHint}" Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <ComboBox MinWidth="170" ItemsSource="{x:Bind Vm.PresetNames}" SelectedItem="{x:Bind Vm.SelectedPreset, Mode=TwoWay}"
                                                  AutomationProperties.Name="{l:Tr Key=overlay.preset}" />
                                        <Button Style="{StaticResource QuietButton}" Content="{l:Tr Key=overlay.presetNew}" Click="OnNewPreset" />
                                        <Button Style="{StaticResource IconButton}" Command="{x:Bind Vm.DeleteActivePresetCommand}"
                                                ToolTipService.ToolTip="{l:Tr Key=overlay.presetDelete}" AutomationProperties.Name="{l:Tr Key=overlay.presetDelete}">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Rectangle Style="{StaticResource DividerLine}" />
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{l:Tr Key=overlay.presetReset}" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="{l:Tr Key=overlay.presetResetHint}" Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource QuietButton}" Content="{l:Tr Key=overlay.presetResetButton}"
                                            Command="{x:Bind Vm.ResetBuiltInPresetsCommand}" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Estilos prontos: cada exemplo é desenhado numa miniatura da tela, com as métricas escolhidas -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{l:Tr Key=overlay.styles}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{l:Tr Key=overlay.stylesHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" />
                        <ItemsRepeater ItemsSource="{x:Bind Vm.Styles}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="200" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" MaximumRowsOrColumns="3" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:StyleVm">
                                    <Border Style="{StaticResource CardBorder}" Padding="12">
                                        <StackPanel Spacing="10">
                                            <ov:ScreenPreview Preset="{x:Bind Preview}" Live="True" Interactive="False" IsHitTestVisible="False" />
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" MaxLines="2" Height="32" />
                                            </StackPanel>
                                            <Button Style="{StaticResource QuietButton}" Content="{l:Tr Key=overlay.applyStyle}" HorizontalAlignment="Stretch"
                                                    Click="OnApplyStyle" Tag="{x:Bind}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <!-- Métricas -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{l:Tr Key=overlay.metrics}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{l:Tr Key=overlay.metricsHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" />
                        <Border Style="{StaticResource CardBorder}" Padding="8">
                            <ListView x:Name="MetricList" ItemsSource="{x:Bind Vm.Items}" SelectionMode="None" CanReorderItems="True"
                                      CanDragItems="True" AllowDrop="True" DragItemsCompleted="OnMetricsReordered" MaxHeight="460">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="MinHeight" Value="40" />
                                        <Setter Property="Padding" Value="8,0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OverlayItemVm">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="76" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE76F;" FontSize="12" Foreground="{ThemeResource TextTertiaryBrush}"
                                                      ToolTipService.ToolTip="{l:Tr Key=overlay.dragHint}" />
                                            <CheckBox Grid.Column="1" IsChecked="{x:Bind Visible, Mode=TwoWay}" MinWidth="0"
                                                      AutomationProperties.Name="{x:Bind DefaultName}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind DefaultName}" VerticalAlignment="Center" Style="{StaticResource BodyText}" />
                                            <TextBox Grid.Column="3" Text="{x:Bind Label, Mode=TwoWay}" PlaceholderText="{l:Tr Key=overlay.customLabel}"
                                                     MaxLength="24" LostFocus="OnLabelLostFocus" VerticalAlignment="Center"
                                                     AutomationProperties.Name="{l:Tr Key=overlay.customLabel}" />
                                            <Border Grid.Column="4" Style="{StaticResource TagBorder}" HorizontalAlignment="Left">
                                                <TextBlock Text="{x:Bind SourceText}" Style="{StaticResource TagText}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </StackPanel>

                    <!-- Aparência -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{l:Tr Key=overlay.appearance}" Style="{StaticResource SectionTitleText}" />
                        <Border Style="{StaticResource CardBorder}" Padding="20,6">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:Tr Key=overlay.layout}" Style="{StaticResource RowLabel}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <ComboBox MinWidth="140" ItemsSource="{x:Bind Vm.Orientations}" SelectedItem="{x:Bind Vm.Orientation, Mode=TwoWay}"
                                                  AutomationProperties.Name="{l:Tr Key=overlay.layout}" />
                                        <ComboBox MinWidth="140" ItemsSource="{x:Bind Vm.Alignments}" SelectedItem="{x:Bind Vm.Alignment, Mode=TwoWay}"
                                                  AutomationProperties.Name="{l:Tr Key=overlay.alignment}" />
                                    </StackPanel>
                                </Grid>
                                <Rectangle Style="{StaticResource DividerLine}" />
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:Tr Key=overlay.fontSize}" Style="{StaticResource RowLabel}" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="9" Maximum="24" StepFrequency="1" Value="{x:Bind Vm.FontSize, Mode=TwoWay}"
                                            AutomationProperties.Name="{l:Tr Key=overlay.fontSize}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:Tr Key=overlay.scale}" Style="{StaticResource RowLabel}" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0.5" Maximum="2" StepFrequency="0.05" Value="{x:Bind Vm.Scale, Mode=TwoWay}"
                                            AutomationProperties.Name="{l:Tr Key=overlay.scale}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:Tr Key=overlay.opacity}" Style="{StaticResource RowLabel}" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="5" Value="{x:Bind Vm.Opacity, Mode=TwoWay}"
                                            AutomationProperties.Name="{l:Tr Key=overlay.opacity}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:Tr Key=overlay.cornerRadius}" Style="{StaticResource RowLabel}" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="16" StepFrequency="1" Value="{x:Bind Vm.CornerRadius, Mode=TwoWay}"
                                            AutomationProperties.Name="{l:Tr Key=overlay.cornerRadius}" />
                                </Grid>
                                <Rectangle Style="{StaticResource DividerLine}" />
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:Tr Key=overlay.textColor}" Style="{StaticResource RowLabel}" VerticalAlignment="Center" />
                                    <GridView Grid.Column="1" ItemsSource="{x:Bind Vm.TextColors}" SelectedItem="{x:Bind Vm.TextColor, Mode=TwoWay}"
                                              ItemTemplate="{StaticResource SwatchTemplate}" ItemsPanel="{StaticResource HorizontalPanel}"
                                              SelectionMode="Single" AutomationProperties.Name="{l:Tr Key=overlay.textColor}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:Tr Key=overlay.accentColor}" Style="{StaticResource RowLabel}" VerticalAlignment="Center" />
                                    <GridView Grid.Column="1" ItemsSource="{x:Bind Vm.Accents}" SelectedItem="{x:Bind Vm.AccentColor, Mode=TwoWay}"
                                              ItemTemplate="{StaticResource SwatchTemplate}" ItemsPanel="{StaticResource HorizontalPanel}"
                                              SelectionMode="Single" AutomationProperties.Name="{l:Tr Key=overlay.accentColor}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:Tr Key=overlay.background}" Style="{StaticResource RowLabel}" VerticalAlignment="Center" />
                                    <GridView Grid.Column="1" ItemsSource="{x:Bind Vm.Backgrounds}" SelectedItem="{x:Bind Vm.BackgroundColor, Mode=TwoWay}"
                                              ItemTemplate="{StaticResource SwatchTemplate}" ItemsPanel="{StaticResource HorizontalPanel}"
                                              SelectionMode="Single" AutomationProperties.Name="{l:Tr Key=overlay.background}" />
                                </Grid>
                                <Rectangle Style="{StaticResource DividerLine}" />
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:Tr Key=overlay.graphs}" Style="{StaticResource RowLabel}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                                        <CheckBox Content="{l:Tr Key=overlay.showBars}" IsChecked="{x:Bind Vm.ShowBars, Mode=TwoWay}" />
                                        <CheckBox Content="{l:Tr Key=overlay.showGraphs}" IsChecked="{x:Bind Vm.ShowGraphs, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Posição e atualização -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{l:Tr Key=overlay.position}" Style="{StaticResource SectionTitleText}" />
                        <Border Style="{StaticResource CardBorder}" Padding="20,6">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:Tr Key=overlay.monitor}" Style="{StaticResource RowLabel}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" MinWidth="220" ItemsSource="{x:Bind Vm.Monitors}" SelectedItem="{x:Bind Vm.Monitor, Mode=TwoWay}"
                                              AutomationProperties.Name="{l:Tr Key=overlay.monitor}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:Tr Key=overlay.anchor}" Style="{StaticResource RowLabel}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" MinWidth="220" ItemsSource="{x:Bind Vm.Anchors}" SelectedItem="{x:Bind Vm.Anchor, Mode=TwoWay}"
                                              AutomationProperties.Name="{l:Tr Key=overlay.anchor}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{l:Tr Key=overlay.offset}" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="{l:Tr Key=overlay.offsetHint}" Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <NumberBox Header="X" Minimum="0" Maximum="8000" SmallChange="4" Value="{x:Bind Vm.OffsetX, Mode=TwoWay}" Width="100"
                                                   SpinButtonPlacementMode="Hidden" />
                                        <NumberBox Header="Y" Minimum="0" Maximum="8000" SmallChange="4" Value="{x:Bind Vm.OffsetY, Mode=TwoWay}" Width="100"
                                                   SpinButtonPlacementMode="Hidden" />
                                    </StackPanel>
                                </Grid>
                                <Rectangle Style="{StaticResource DividerLine}" />
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{l:Tr Key=overlay.editMode}" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="{l:Tr Key=overlay.editModeHint}" Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" IsChecked="{x:Bind Vm.EditMode, Mode=OneWay}" Command="{x:Bind Vm.ToggleEditModeCommand}"
                                                  Content="{l:Tr Key=overlay.editModeButton}" CornerRadius="{StaticResource ControlRadius}"
                                                  IsEnabled="{x:Bind Vm.Enabled, Mode=OneWay}" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{l:Tr Key=overlay.intervalLabel}" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="{l:Tr Key=overlay.intervalHint}" Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" MinWidth="140" ItemsSource="{x:Bind Vm.Intervals}" SelectedItem="{x:Bind Vm.Interval, Mode=TwoWay}"
                                              VerticalAlignment="Center" AutomationProperties.Name="{l:Tr Key=overlay.intervalLabel}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{l:Tr Key=overlay.onlyInGame}" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="{l:Tr Key=overlay.onlyInGameHint}" Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Vm.OnlyInGame, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                                  AutomationProperties.Name="{l:Tr Key=overlay.onlyInGame}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Atalho -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{l:Tr Key=overlay.hotkey}" Style="{StaticResource SectionTitleText}" />
                        <Border Style="{StaticResource CardBorder}" Padding="20,6">
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{l:Tr Key=overlay.hotkeyToggle}" Style="{StaticResource RowLabel}" />
                                    <TextBlock Text="{x:Bind Vm.HotkeyStatus, Mode=OneWay}" Style="{StaticResource RowHint}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBox x:Name="HotkeyBox" Width="170" IsReadOnly="True" Text="{x:Bind Vm.Hotkey, Mode=OneWay}"
                                             PreviewKeyDown="OnHotkeyKeyDown" PlaceholderText="{l:Tr Key=overlay.hotkeyPress}"
                                             AutomationProperties.Name="{l:Tr Key=overlay.hotkey}" />
                                    <Button Style="{StaticResource QuietButton}" Content="{l:Tr Key=overlay.hotkeyChange}" Click="OnHotkeyChange" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Jogos -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{l:Tr Key=overlay.games}" Style="{StaticResource SectionTitleText}" />
                        <Border Style="{StaticResource CardBorder}" Padding="20,6">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{l:Tr Key=overlay.autoDetect}" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="{l:Tr Key=overlay.autoDetectHint}" Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Vm.AutoDetect, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                                  AutomationProperties.Name="{l:Tr Key=overlay.autoDetect}" />
                                </Grid>
                                <Rectangle Style="{StaticResource DividerLine}" />
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{l:Tr Key=overlay.manual}" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="{l:Tr Key=overlay.manualHint}" Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBox Width="200" Text="{x:Bind Vm.ManualExecutable, Mode=TwoWay}" PlaceholderText="jogo.exe"
                                                 LostFocus="OnManualLostFocus" AutomationProperties.Name="{l:Tr Key=overlay.manual}" />
                                        <Button Style="{StaticResource QuietButton}" Content="{l:Tr Key=overlay.browse}" Click="OnBrowseExe" />
                                        <Button Style="{StaticResource IconButton}" Command="{x:Bind Vm.ClearManualCommand}"
                                                ToolTipService.ToolTip="{l:Tr Key=overlay.manualClear}" AutomationProperties.Name="{l:Tr Key=overlay.manualClear}">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Rectangle Style="{StaticResource DividerLine}" />
                                <StackPanel Spacing="6" Padding="0,10">
                                    <TextBlock Text="{l:Tr Key=overlay.exclusions}" Style="{StaticResource RowLabel}" />
                                    <TextBlock Text="{l:Tr Key=overlay.exclusionsHint}" Style="{StaticResource RowHint}" />
                                    <TextBox Text="{x:Bind Vm.ExclusionsText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                                             PlaceholderText="launcher.exe" LostFocus="OnExclusionsLostFocus"
                                             AutomationProperties.Name="{l:Tr Key=overlay.exclusions}" />
                                </StackPanel>
                                <Rectangle Style="{StaticResource DividerLine}" />
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{l:Tr Key=overlay.gamePresets}" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="{l:Tr Key=overlay.gamePresetsHint}" Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource QuietButton}" Content="{l:Tr Key=overlay.assignPreset}"
                                            Command="{x:Bind Vm.AssignPresetToGameCommand}" IsEnabled="{x:Bind Vm.HasTarget, Mode=OneWay}" VerticalAlignment="Center" />
                                </Grid>
                                <ItemsRepeater ItemsSource="{x:Bind Vm.GamePresets}" Margin="0,0,0,8">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="4" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GamePresetVm">
                                            <Grid ColumnSpacing="8" Padding="12,6" CornerRadius="6" Background="{ThemeResource RaisedBackgroundBrush}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyText}">
                                                    <Run Text="{x:Bind Executable}" FontWeight="SemiBold" /><Run Text="  →  " /><Run Text="{x:Bind Preset}" />
                                                </TextBlock>
                                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="OnRemoveGamePreset" Tag="{x:Bind}"
                                                        ToolTipService.ToolTip="{l:Tr Key=overlay.removeGamePreset}" AutomationProperties.Name="{l:Tr Key=overlay.removeGamePreset}">
                                                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <Rectangle Style="{StaticResource DividerLine}" />
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{l:Tr Key=overlay.record}" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="{l:Tr Key=overlay.recordHint}" Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Vm.RecordSessions, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                                  AutomationProperties.Name="{l:Tr Key=overlay.record}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Rede -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{l:Tr Key=overlay.network}" Style="{StaticResource SectionTitleText}" />
                        <Border Style="{StaticResource CardBorder}" Padding="20,6">
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{l:Tr Key=overlay.pingHost}" Style="{StaticResource RowLabel}" />
                                    <TextBlock Text="{l:Tr Key=overlay.pingHostHint}" Style="{StaticResource RowHint}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Width="200" Text="{x:Bind Vm.PingHost, Mode=TwoWay}" LostFocus="OnPingLostFocus"
                                         VerticalAlignment="Center" AutomationProperties.Name="{l:Tr Key=overlay.pingHost}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Coluna lateral: prévia e jogo detectado -->
                <StackPanel x:Name="Side" Grid.Column="1" Spacing="16">
                    <!-- Prévia na tela: posição e tamanho reais, em miniatura -->
                    <Border Style="{StaticResource CardBorder}" Padding="16,14,16,16">
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock Text="{l:Tr Key=overlay.screenPreview}" Style="{StaticResource SectionTitleText}" FontSize="14" />
                                <TextBlock Text="{l:Tr Key=overlay.previewLive}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <ov:ScreenPreview x:Name="ScreenMini" Preset="{x:Bind Vm.CurrentPreset, Mode=OneWay}" Live="True" Interactive="True" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None">
                                    <Run Text="{l:Tr Key=overlay.positionNow}" /> <Run Text="{x:Bind Vm.PositionText, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                            </Grid>
                            <TextBlock Text="{l:Tr Key=overlay.screenPreviewHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" />
                        </StackPanel>
                    </Border>

                    <!-- Tamanho real: para julgar legibilidade -->
                    <Border Style="{StaticResource CardBorder}" Padding="0">
                        <StackPanel>
                            <Grid Padding="16,12">
                                <TextBlock Text="{l:Tr Key=overlay.preview}" Style="{StaticResource SectionTitleText}" FontSize="14" />
                                <TextBlock Text="{l:Tr Key=overlay.previewActual}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <!-- Fundo médio (nem preto nem claro), para julgar o contraste como sobre uma cena de jogo -->
                            <Border x:Name="PreviewStage" MinHeight="100" Padding="16" CornerRadius="0,0,8,8" Background="#3A4046">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Auto">
                                    <ContentPresenter x:Name="PreviewHost" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{l:Tr Key=overlay.game, Upper=True}" Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="{x:Bind Vm.TargetTitle, Mode=OneWay}" Style="{StaticResource SectionTitleText}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Vm.TargetDetail, Mode=OneWay}" Style="{StaticResource SecondaryText}" FontSize="12" />
                            <InfoBar IsOpen="{x:Bind Vm.ExclusiveFullscreen, Mode=OneWay}" IsClosable="False" Severity="Warning"
                                     Title="{l:Tr Key=overlay.exclusiveTitle}" Message="{l:Tr Key=overlay.exclusive}" />
                            <TextBlock Text="{x:Bind Vm.VisibilityText, Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" />
                            <Button Style="{StaticResource QuietButton}" Command="{x:Bind Vm.ToggleVisibleCommand}" IsEnabled="{x:Bind Vm.Enabled, Mode=OneWay}">
                                <TextBlock>
                                    <Run Text="{l:Tr Key=overlay.toggleVisible}" /> <Run Text="(" /><Run Text="{x:Bind Vm.Hotkey, Mode=OneWay}" /><Run Text=")" />
                                </TextBlock>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{l:Tr Key=overlay.presenting, Upper=True}" Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="{l:Tr Key=overlay.presentingHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" />
                            <ItemsRepeater ItemsSource="{x:Bind Vm.Presenting}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="4" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PresentingVm">
                                        <Grid ColumnSpacing="8" Padding="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Executable}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                                <TextBlock Style="{StaticResource CaptionText}">
                                                    <Run Text="{x:Bind FpsText}" /><Run Text=" · " /><Run Text="{x:Bind Runtime}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource QuietButton}" Padding="8,3" FontSize="12"
                                                    Content="{l:Tr Key=overlay.useThis}" Click="OnUseProcess" Tag="{x:Bind}" />
                                            <Button Grid.Column="2" Style="{StaticResource QuietButton}" Padding="8,3" FontSize="12"
                                                    Content="{l:Tr Key=overlay.ignore}" Click="OnIgnoreProcess" Tag="{x:Bind}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
    <Border x:Name="FloatingPreview" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="24" Width="380" Style="{StaticResource CardBorder}" Padding="12">
        <StackPanel Spacing="8">
            <TextBlock Text="{l:Tr Key=overlay.preview}" Style="{StaticResource SectionTitleText}" FontSize="14" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="220">
                <ContentPresenter x:Name="FloatingPreviewHost" />
            </ScrollViewer>
        </StackPanel>
    </Border>
    </Grid>
</Page>
