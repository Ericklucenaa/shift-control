<Page
    x:Class="ShiftControl.App.Views.ChecksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ShiftControl.App.Services"
    xmlns:vm="using:ShiftControl.App.ViewModels"
    xmlns:v="using:ShiftControl.App.Views"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="CheckTemplate" x:DataType="vm:CheckItemVm">
            <Grid ColumnSpacing="14" Padding="16,12" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="9" Height="9" VerticalAlignment="Top" Margin="0,6,0,0" Fill="{x:Bind v:ViewHelpers.CheckBrush(Status)}" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource SecondaryText}" FontSize="12.5" Visibility="{x:Bind v:ViewHelpers.Visible(HasDetail)}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind v:ViewHelpers.CheckBrush(Status)}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource QuietButton}" Padding="10,4" FontSize="12" Content="{x:Bind FixLabel}" Tag="{x:Bind}"
                            Click="OnFix" Visibility="{x:Bind v:ViewHelpers.Visible(HasFix)}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20" MaxWidth="1100" HorizontalAlignment="Left">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="{l:Tr Key=nav.group.tools, Upper=True}" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="{l:Tr Key=nav.checks}" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="{l:Tr Key=checks.subtitle}" Style="{StaticResource CaptionText}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Command="{x:Bind Vm.RunCommand}"
                        IsEnabled="{x:Bind v:ViewHelpers.Not(Vm.Loading), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        <TextBlock Text="{l:Tr Key=checks.run}" />
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <ProgressRing IsActive="True" Width="16" Height="16" Visibility="{x:Bind v:ViewHelpers.Visible(Vm.Loading), Mode=OneWay}" />
                <TextBlock Text="{x:Bind Vm.Summary, Mode=OneWay}" Style="{StaticResource BodyText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind Vm.CheckedAt, Mode=OneWay}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind v:ViewHelpers.Visible(Vm.CheckingSlow), Mode=OneWay}">
                    <ProgressRing IsActive="True" Width="14" Height="14" />
                    <TextBlock Text="{l:Tr Key=checks.slow}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8" Visibility="{x:Bind v:ViewHelpers.Visible(Vm.HasResults), Mode=OneWay}">
                <TextBlock Text="{l:Tr Key=checks.gamer}" Style="{StaticResource SectionTitleText}" />
                <TextBlock Text="{l:Tr Key=checks.gamerHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" />
                <Border Style="{StaticResource CardBorder}" Padding="0,0,0,0">
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Gamer}" ItemTemplate="{StaticResource CheckTemplate}" />
                </Border>
            </StackPanel>

            <StackPanel Spacing="8" Visibility="{x:Bind v:ViewHelpers.Visible(Vm.HasResults), Mode=OneWay}">
                <TextBlock Text="{l:Tr Key=checks.post}" Style="{StaticResource SectionTitleText}" />
                <TextBlock Text="{l:Tr Key=checks.postHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" />
                <Border Style="{StaticResource CardBorder}" Padding="0">
                    <ItemsRepeater ItemsSource="{x:Bind Vm.PostFormat}" ItemTemplate="{StaticResource CheckTemplate}" />
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
