<Page
    x:Class="ShiftControl.App.Views.ComponentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ShiftControl.App.Services"
    xmlns:v="using:ShiftControl.App.Views"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="ComponentTemplate" x:DataType="v:ComponentRow">
            <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyText}"
                           FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionText}"
                           Visibility="{x:Bind v:ViewHelpers.Visible(HasDetail)}"
                           TextWrapping="Wrap" TextTrimming="None" IsTextSelectionEnabled="True" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ComponentSectionTemplate" x:DataType="v:ComponentSection">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource SectionTitleText}"
                               AutomationProperties.HeadingLevel="Level2" TextWrapping="Wrap" />
                    <ItemsRepeater ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource ComponentTemplate}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="10" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="16" MaxWidth="1000">
            <StackPanel Spacing="4">
                <TextBlock Text="{l:Tr Key=nav.group.hardware, Upper=True}" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="{l:Tr Key=nav.components}" Style="{StaticResource PageTitleText}"
                           AutomationProperties.HeadingLevel="Level1" TextWrapping="Wrap" />
                <TextBlock Text="{l:Tr Key=components.subtitle}" Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" TextTrimming="None" />
            </StackPanel>
            <Button x:Name="RefreshButton" Content="{l:Tr Key=components.refresh}"
                    Style="{StaticResource QuietButton}" Click="OnRefresh" />
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed"
                         AutomationProperties.Name="{l:Tr Key=components.loading}" />
            <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False"
                     Title="{l:Tr Key=components.error}" />
            <ItemsRepeater x:Name="Sections" ItemTemplate="{StaticResource ComponentSectionTemplate}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="12" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
