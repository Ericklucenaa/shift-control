<Page
    x:Class="ShiftControl.App.Views.ProgramsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ShiftControl.App.Services"
    xmlns:v="using:ShiftControl.App.Views"
    xmlns:vm="using:ShiftControl.App.ViewModels"
    NavigationCacheMode="Required" Background="Transparent">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12" MaxWidth="1600">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="2">
            <TextBlock Text="{l:Tr Key=nav.group.system, Upper=True}" Style="{StaticResource EyebrowText}" />
            <TextBlock Text="{l:Tr Key=nav.programs}" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{l:Tr Key=programs.subtitle}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" />
        </StackPanel>
        <InfoBar Grid.Row="1" IsOpen="{x:Bind v:ViewHelpers.HasText(Vm.Message), Mode=OneWay}" IsClosable="True"
                 Message="{x:Bind Vm.Message, Mode=OneWay}" Severity="{x:Bind v:SettingsPage.StatusSeverity(Vm.MessageIsError), Mode=OneWay}" />

        <!-- Desinstalação em andamento: o desinstalador do programa tem a própria janela; aqui só acompanhamos. -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16,12" Visibility="{x:Bind v:ViewHelpers.Visible(Vm.Uninstalling), Mode=OneWay}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ProgressRing IsActive="{x:Bind Vm.Uninstalling, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Bind Vm.UninstallStatus, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
                <Button Grid.Column="2" Content="{l:Tr Key=programs.stopWaiting}" Command="{x:Bind Vm.StopWaitingCommand}" Style="{StaticResource QuietButton}"
                        ToolTipService.ToolTip="{l:Tr Key=programs.stopWaitingTip}" AutomationProperties.AutomationId="programs.stopWaiting" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="190" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox Text="{x:Bind Vm.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Tr Key=programs.search}"
                     AutomationProperties.AutomationId="programs.search" AutomationProperties.Name="{l:Tr Key=programs.search}" />
            <ComboBox Grid.Column="1" ItemsSource="{x:Bind Vm.DriveOptions}" SelectedItem="{x:Bind Vm.Drive, Mode=TwoWay}" MinWidth="190" MaxWidth="300"
                      ToolTipService.ToolTip="{l:Tr Key=programs.driveLabel}"
                      AutomationProperties.AutomationId="programs.drive" AutomationProperties.Name="{l:Tr Key=programs.driveLabel}" />
            <ComboBox Grid.Column="2" ItemsSource="{x:Bind Vm.SortOptions}" SelectedItem="{x:Bind Vm.Sort, Mode=TwoWay}" HorizontalAlignment="Stretch"
                      AutomationProperties.AutomationId="programs.sort" AutomationProperties.Name="{l:Tr Key=programs.sortLabel}" />
            <Button Grid.Column="3" Content="{l:Tr Key=common.refresh}" Command="{x:Bind Vm.RefreshCommand}" Style="{StaticResource QuietButton}"
                    AutomationProperties.AutomationId="programs.refresh" />
            <Button Grid.Column="4" Content="{l:Tr Key=programs.uninstall}" Style="{StaticResource PrimaryButton}" Click="OnUninstall"
                    IsEnabled="{x:Bind Vm.CanUninstall, Mode=OneWay}" AutomationProperties.AutomationId="programs.uninstall" />
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid x:Name="Header" Padding="24,10" ColumnSpacing="12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardBorderBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition x:Name="HeadVersion" Width="130" /><ColumnDefinition Width="48" /><ColumnDefinition Width="90" /><ColumnDefinition x:Name="HeadDate" Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l:Tr Key=programs.col.name}" Style="{StaticResource CaptionText}" />
                    <TextBlock Grid.Column="1" Text="{l:Tr Key=programs.col.version}" Style="{StaticResource CaptionText}" />
                    <TextBlock Grid.Column="2" Text="{l:Tr Key=programs.col.drive}" Style="{StaticResource CaptionText}" />
                    <TextBlock Grid.Column="3" Text="{l:Tr Key=programs.col.size}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="{l:Tr Key=programs.col.installed}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                </Grid>
                <ListView x:Name="ProgramList" Grid.Row="1" ItemsSource="{x:Bind Vm.Programs}" SelectedItem="{x:Bind Vm.SelectedProgram, Mode=TwoWay}"
                          SelectionMode="Single" HorizontalContentAlignment="Stretch" ContextRequested="OnContextRequested"
                          AutomationProperties.AutomationId="programs.list" AutomationProperties.Name="{l:Tr Key=nav.programs}">
                    <ListView.KeyboardAccelerators><KeyboardAccelerator Key="Delete" Invoked="OnDeleteKey" /></ListView.KeyboardAccelerators>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProgramRowVm">
                            <Grid Padding="8,8" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Name}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="48" /><ColumnDefinition Width="90" /><ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Name}" />
                                    <TextBlock Text="{x:Bind PublisherText}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind VersionText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind VersionText}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind DriveText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" Style="{StaticResource MetricValueText}" FontWeight="Normal" VerticalAlignment="Center"
                                           ToolTipService.ToolTip="{x:Bind SizeTip}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind DateText}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind v:ViewHelpers.Visible(Vm.Empty), Mode=OneWay}">
                    <TextBlock Text="{l:Tr Key=programs.empty}" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Center" />
                    <TextBlock Text="{l:Tr Key=programs.emptyHint}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <ProgressRing Grid.Row="1" IsActive="{x:Bind Vm.Busy, Mode=OneWay}" Width="28" Height="28" Visibility="{x:Bind v:ViewHelpers.Visible(Vm.Busy), Mode=OneWay}" />
                <TextBlock Grid.Row="2" Padding="16,8" Text="{x:Bind Vm.Summary, Mode=OneWay}" Style="{StaticResource CaptionText}" />
                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardBorderBrush}" />
            </Grid>
        </Border>

        <Grid Grid.Row="5" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Vm.SelectionHint, Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" />
                <TextBlock Text="{x:Bind Vm.LocationText, Mode=OneWay}" Style="{StaticResource CaptionText}" IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis"
                           Visibility="{x:Bind v:ViewHelpers.Visible(Vm.HasSelection), Mode=OneWay}" />
            </StackPanel>
            <Button Grid.Column="1" Content="{l:Tr Key=programs.openLocation}" Command="{x:Bind Vm.OpenLocationCommand}" Style="{StaticResource QuietButton}"
                    IsEnabled="{x:Bind Vm.HasLocation, Mode=OneWay}" AutomationProperties.AutomationId="programs.openLocation" />
        </Grid>

    </Grid>
</Page>
