<Page
    x:Class="ShiftControl.App.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ShiftControl.App.Services"
    xmlns:v="using:ShiftControl.App.Views"
    xmlns:c="using:ShiftControl.App.Controls"
    NavigationCacheMode="Required"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20" MaxWidth="1100" HorizontalAlignment="Left">
            <StackPanel Spacing="2">
                <TextBlock Text="{l:Tr Key=nav.group.maintenance, Upper=True}" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="{l:Tr Key=nav.network}" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{l:Tr Key=network.subtitle}" Style="{StaticResource CaptionText}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" />
            </StackPanel>

            <InfoBar IsOpen="{x:Bind v:ViewHelpers.HasText(Vm.Message), Mode=OneWay}" IsClosable="True" Message="{x:Bind Vm.Message, Mode=OneWay}"
                     Severity="{x:Bind v:SettingsPage.StatusSeverity(Vm.MessageIsError), Mode=OneWay}" />

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox IsEditable="True" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Vm.Hosts}" Text="{x:Bind Vm.Host, Mode=TwoWay}"
                                  Header="{l:Tr Key=network.server}" />
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Command="{x:Bind Vm.RunCommand}"
                                Content="{x:Bind v:ViewHelpers.RunButton(Vm.Running), Mode=OneWay}" MinWidth="120" />
                    </Grid>
                    <ProgressBar Value="{x:Bind Vm.ProgressValue, Mode=OneWay}" Maximum="100" Visibility="{x:Bind v:ViewHelpers.Visible(Vm.Running), Mode=OneWay}" />
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Stats}" ItemTemplate="{StaticResource StatTemplate}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="140" MinColumnSpacing="16" MinRowSpacing="12" ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <c:LineChart Height="120" Values="{x:Bind Vm.Samples, Mode=OneWay}" Slots="40" Minimum="0" />
                    <TextBlock Text="{x:Bind Vm.Verdict, Mode=OneWay}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                               Visibility="{x:Bind v:ViewHelpers.Visible(Vm.HasResult), Mode=OneWay}" />
                    <TextBlock Text="{l:Tr Key=network.hint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="8">
                <Grid>
                    <TextBlock Text="{l:Tr Key=network.history}" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Content="{l:Tr Key=common.clearHistory}" Command="{x:Bind Vm.ClearHistoryCommand}"
                            Visibility="{x:Bind v:ViewHelpers.Visible(Vm.HasHistory), Mode=OneWay}" />
                </Grid>
                <Border Style="{StaticResource CardBorder}" Padding="0">
                    <Grid>
                        <ItemsRepeater ItemsSource="{x:Bind Vm.History}" ItemTemplate="{StaticResource RowTemplate}" />
                        <TextBlock Text="{l:Tr Key=network.historyEmpty}" Style="{StaticResource SecondaryText}" Margin="16,14" TextWrapping="Wrap"
                                   Visibility="{x:Bind v:ViewHelpers.Collapsed(Vm.HasHistory), Mode=OneWay}" />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
