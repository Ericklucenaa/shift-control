<Page
    x:Class="ShiftControl.App.Views.GameBoostPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ShiftControl.App.Services"
    xmlns:vm="using:ShiftControl.App.ViewModels"
    xmlns:v="using:ShiftControl.App.Views"
    NavigationCacheMode="Required"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20" MaxWidth="1100" HorizontalAlignment="Left">
            <StackPanel Spacing="2">
                <TextBlock Text="{l:Tr Key=nav.group.gaming, Upper=True}" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="{l:Tr Key=nav.boost}" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{l:Tr Key=boost.subtitle}" Style="{StaticResource CaptionText}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" />
            </StackPanel>

            <InfoBar IsOpen="{x:Bind v:ViewHelpers.HasText(Vm.Message), Mode=OneWay}" IsClosable="True" Message="{x:Bind Vm.Message, Mode=OneWay}"
                     Severity="{x:Bind v:SettingsPage.StatusSeverity(Vm.MessageIsError), Mode=OneWay}" />

            <!-- Estado -->
            <Border Style="{StaticResource CardBorder}" BorderBrush="{x:Bind v:ViewHelpers.ActiveBorder(Vm.IsActive), Mode=OneWay}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{x:Bind v:ViewHelpers.ActiveBorder(Vm.IsActive), Mode=OneWay}" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{x:Bind Vm.StateTitle, Mode=OneWay}" Style="{StaticResource CardTitleText}" />
                        <TextBlock Text="{x:Bind Vm.StateDetail, Mode=OneWay}" Style="{StaticResource SecondaryText}" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Command="{x:Bind Vm.ToggleCommand}"
                            Content="{x:Bind v:ViewHelpers.BoostButton(Vm.IsActive), Mode=OneWay}" />
                </Grid>
            </Border>

            <!-- Perfil e automático -->
            <StackPanel Spacing="8">
                <TextBlock Text="{l:Tr Key=boost.profiles}" Style="{StaticResource SectionTitleText}" />
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{l:Tr Key=boost.auto}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                <TextBlock Text="{l:Tr Key=boost.autoHint}" Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Vm.AutoApply, Mode=TwoWay}" MinWidth="0" OnContent="" OffContent="" />
                        </Grid>
                        <Rectangle Style="{StaticResource DividerLine}" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="{l:Tr Key=boost.defaultProfile}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                            <StackPanel x:Name="ProfileRadios" Orientation="Horizontal" Spacing="4" />
                            <TextBlock x:Name="ProfileHint" Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Vm.PlanInfo, Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Perfis por jogo -->
            <StackPanel Spacing="8">
                <TextBlock Text="{l:Tr Key=boost.perGame}" Style="{StaticResource SectionTitleText}" />
                <TextBlock Text="{l:Tr Key=boost.perGameHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Width="260" Text="{x:Bind Vm.NewGame, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Tr Key=boost.gameExecutable}" />
                    <Button Content="{l:Tr Key=boost.addGame}" Command="{x:Bind Vm.AddGameCommand}" />
                </StackPanel>
                <Border Style="{StaticResource CardBorder}" Padding="0">
                    <Grid>
                        <ItemsRepeater ItemsSource="{x:Bind Vm.Games}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:GameProfileVm">
                                    <Grid Padding="16,8" ColumnSpacing="12" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Executable}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <ComboBox Grid.Column="1" MinWidth="170" ItemsSource="{x:Bind v:GameBoostPage.Profiles}" SelectedIndex="{x:Bind ProfileIndex, Mode=TwoWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <TextBlock Text="{l:Tr Key=boost.noGames}" Style="{StaticResource SecondaryText}" Margin="16,14" TextWrapping="Wrap"
                                   Visibility="{x:Bind v:ViewHelpers.Collapsed(Vm.HasGames), Mode=OneWay}" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Pausar programas -->
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{l:Tr Key=boost.pause}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{l:Tr Key=boost.pauseHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource QuietButton}" Content="{l:Tr Key=common.refresh}" Command="{x:Bind Vm.RefreshAppsCommand}" VerticalAlignment="Bottom" />
                </Grid>
                <Border Style="{StaticResource CardBorder}" Padding="0">
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Apps}" ItemTemplate="{StaticResource RowTemplate}" />
                </Border>
            </StackPanel>

            <!-- Antes / depois -->
            <StackPanel Spacing="8">
                <TextBlock Text="{l:Tr Key=boost.compare}" Style="{StaticResource SectionTitleText}" />
                <TextBlock Text="{l:Tr Key=boost.compareHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" />
                <Border Style="{StaticResource CardBorder}" Padding="0">
                    <Grid>
                        <ItemsRepeater ItemsSource="{x:Bind Vm.Comparison}" ItemTemplate="{StaticResource RowTemplate}" />
                        <TextBlock Text="{l:Tr Key=boost.compareEmpty}" Style="{StaticResource SecondaryText}" Margin="16,14" TextWrapping="Wrap"
                                   Visibility="{x:Bind v:ViewHelpers.Collapsed(Vm.HasComparison), Mode=OneWay}" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Evidência térmica -->
            <StackPanel Spacing="8">
                <TextBlock Text="{l:Tr Key=boost.thermal}" Style="{StaticResource SectionTitleText}" />
                <TextBlock Text="{x:Bind v:ViewHelpers.OrDefault(Vm.ThermalTitle, 'boost.thermalHint'), Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" />
                <Border Style="{StaticResource CardBorder}" Padding="0">
                    <Grid>
                        <ItemsRepeater ItemsSource="{x:Bind Vm.Thermal}" ItemTemplate="{StaticResource RowTemplate}" />
                        <TextBlock Text="{l:Tr Key=boost.thermalEmpty}" Style="{StaticResource SecondaryText}" Margin="16,14" TextWrapping="Wrap"
                                   Visibility="{x:Bind v:ViewHelpers.Collapsed(Vm.HasThermal), Mode=OneWay}" />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
