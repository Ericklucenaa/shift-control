<Page
    x:Class="ShiftControl.App.Views.UndoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ShiftControl.App.Services"
    xmlns:vm="using:ShiftControl.App.ViewModels"
    xmlns:v="using:ShiftControl.App.Views"
    NavigationCacheMode="Required"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20" MaxWidth="1100" HorizontalAlignment="Left">
            <StackPanel Spacing="2">
                <TextBlock Text="{l:Tr Key=nav.group.system, Upper=True}" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="{l:Tr Key=nav.undo}" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{l:Tr Key=undo.subtitle}" Style="{StaticResource CaptionText}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" />
            </StackPanel>

            <InfoBar IsOpen="{x:Bind v:ViewHelpers.HasText(Vm.Message), Mode=OneWay}" IsClosable="True" Message="{x:Bind Vm.Message, Mode=OneWay}"
                     Severity="{x:Bind v:SettingsPage.StatusSeverity(Vm.MessageIsError), Mode=OneWay}" />

            <!-- Ponto de restauração -->
            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="{l:Tr Key=undo.restorePoint}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                        <TextBlock Text="{l:Tr Key=undo.restorePointHint}" Style="{StaticResource SecondaryText}" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <ProgressRing IsActive="{x:Bind Vm.CreatingPoint, Mode=OneWay}" Width="16" Height="16" />
                        <Button Style="{StaticResource QuietButton}" Content="{l:Tr Key=undo.restorePointCreate}" Command="{x:Bind Vm.CreateRestorePointCommand}"
                                IsEnabled="{x:Bind v:ViewHelpers.Not(Vm.CreatingPoint), Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Histórico -->
            <StackPanel Spacing="8">
                <TextBlock Text="{l:Tr Key=undo.history}" Style="{StaticResource SectionTitleText}" />
                <Border Style="{StaticResource CardBorder}" Padding="0">
                    <Grid>
                        <ItemsRepeater ItemsSource="{x:Bind Vm.Changes}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChangeVm">
                                    <Grid ColumnSpacing="14" Padding="16,12" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="9" Height="9" VerticalAlignment="Top" Margin="0,6,0,0" Fill="{x:Bind v:ViewHelpers.ChangeBrush(Entry.State)}" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" />
                                            <TextBlock Style="{StaticResource CaptionText}">
                                                <Run Text="{x:Bind AreaText}" /><Run Text=" · " /><Run Text="{x:Bind When}" /><Run Text=" · " /><Run Text="{x:Bind StateText}" />
                                            </TextBlock>
                                            <TextBlock Text="{x:Bind Result}" Style="{StaticResource SecondaryText}" FontSize="12" Visibility="{x:Bind v:ViewHelpers.Visible(HasResult)}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <ProgressRing IsActive="{x:Bind Busy, Mode=OneWay}" Width="14" Height="14" />
                                            <Button Style="{StaticResource QuietButton}" Padding="10,4" FontSize="12" Content="{l:Tr Key=undo.revert}"
                                                    Tag="{x:Bind}" Click="OnRevert" Visibility="{x:Bind v:ViewHelpers.Visible(CanRevert)}"
                                                    IsEnabled="{x:Bind v:ViewHelpers.Not(Busy), Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <StackPanel Spacing="4" Padding="20" Visibility="{x:Bind v:ViewHelpers.Visible(Vm.IsEmpty), Mode=OneWay}">
                            <TextBlock Text="{l:Tr Key=undo.emptyTitle}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                            <TextBlock Text="{l:Tr Key=undo.emptyMessage}" Style="{StaticResource SecondaryText}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
