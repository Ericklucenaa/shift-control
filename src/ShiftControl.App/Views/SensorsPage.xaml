<Page
    x:Class="ShiftControl.App.Views.SensorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ShiftControl.App.Services"
    xmlns:vm="using:ShiftControl.App.ViewModels"
    xmlns:v="using:ShiftControl.App.Views"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Page.Resources>
        <CollectionViewSource x:Name="GroupedSensors" IsSourceGrouped="True" Source="{x:Bind Vm.Groups}" />
        <!-- Colunas compartilhadas entre o cabeçalho e as linhas -->
        <GridLength x:Key="ColStar">36</GridLength>
        <GridLength x:Key="ColType">110</GridLength>
        <GridLength x:Key="ColValue">110</GridLength>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16" MaxWidth="1680">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid ColumnSpacing="16" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="{l:Tr Key=nav.group.hardware, Upper=True}" Style="{StaticResource EyebrowText}" />
                <TextBlock Text="{l:Tr Key=nav.sensors}" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{x:Bind Vm.Summary, Mode=OneWay}" Style="{StaticResource CaptionText}" FontSize="13" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <TextBox x:Name="Search" Width="240" PlaceholderText="{l:Tr Key=sensors.search}"
                         Text="{x:Bind Vm.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{l:Tr Key=sensors.search}">
                    <TextBox.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" Invoked="OnClearSearch" />
                    </TextBox.KeyboardAccelerators>
                </TextBox>
                <Button Style="{StaticResource QuietButton}" Command="{x:Bind Vm.ResetStatsCommand}"
                        ToolTipService.ToolTip="{l:Tr Key=sensors.resetTip}">
                    <TextBlock Text="{l:Tr Key=sensors.reset}" />
                </Button>
                <DropDownButton CornerRadius="{StaticResource ControlRadius}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                        <TextBlock Text="{l:Tr Key=sensors.export}" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="{l:Tr Key=sensors.exportCsv}" Click="OnExportCsv" />
                            <MenuFlyoutItem Text="{l:Tr Key=sensors.exportJson}" Click="OnExportJson" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar IsOpen="{x:Bind v:ViewHelpers.Not(Vm.IsElevated), Mode=OneWay}" IsClosable="True" Severity="Informational"
                     Title="{l:Tr Key=sensors.adminTitle}" Message="{l:Tr Key=sensors.adminMessage}" />
            <InfoBar x:Name="ExportBar" IsOpen="False" IsClosable="True" />
        </StackPanel>

        <!-- Tabela -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="12,10,16,10" ColumnSpacing="12" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource ColStar}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource ColType}" />
                        <ColumnDefinition Width="{StaticResource ColValue}" />
                        <ColumnDefinition Width="{StaticResource ColValue}" />
                        <ColumnDefinition Width="{StaticResource ColValue}" />
                        <ColumnDefinition Width="{StaticResource ColValue}" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="{l:Tr Key=sensors.col.sensor, Upper=True}" Style="{StaticResource EyebrowText}" />
                    <TextBlock Grid.Column="2" Text="{l:Tr Key=sensors.col.type, Upper=True}" Style="{StaticResource EyebrowText}" />
                    <TextBlock Grid.Column="3" Text="{l:Tr Key=sensors.col.current, Upper=True}" Style="{StaticResource EyebrowText}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="{l:Tr Key=sensors.col.min, Upper=True}" Style="{StaticResource EyebrowText}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="{l:Tr Key=sensors.col.max, Upper=True}" Style="{StaticResource EyebrowText}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="6" Text="{l:Tr Key=sensors.col.avg, Upper=True}" Style="{StaticResource EyebrowText}" HorizontalAlignment="Right" />
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{x:Bind GroupedSensors.View, Mode=OneWay}" SelectionMode="None"
                          IsItemClickEnabled="False" Padding="0,0,0,8">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="Padding" Value="12,0,16,0" />
                            <Setter Property="MinHeight" Value="34" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.GroupStyle>
                        <GroupStyle HidesIfEmpty="True">
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="vm:SensorGroup">
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,2">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Category}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind CountText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SensorRow">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource ColStar}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{StaticResource ColType}" />
                                    <ColumnDefinition Width="{StaticResource ColValue}" />
                                    <ColumnDefinition Width="{StaticResource ColValue}" />
                                    <ColumnDefinition Width="{StaticResource ColValue}" />
                                    <ColumnDefinition Width="{StaticResource ColValue}" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource IconButton}" Command="{x:Bind ToggleFavoriteCommand}"
                                        ToolTipService.ToolTip="{x:Bind FavoriteTip, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind FavoriteTip, Mode=OneWay}">
                                    <FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}" FontSize="13"
                                              Foreground="{ThemeResource AccentTextBrush}" />
                                </Button>
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="13" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind TypeText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Value.Text, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                           Opacity="{x:Bind v:SensorsPage.ValueOpacity(Value.Available), Mode=OneWay}"
                                           ToolTipService.ToolTip="{x:Bind Value.Hint, Mode=OneWay}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind MinText, Mode=OneWay}" FontSize="13" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind MaxText, Mode=OneWay}" FontSize="13" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="6" Text="{x:Bind AvgText, Mode=OneWay}" FontSize="13" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="1" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{x:Bind v:ViewHelpers.Visible(Vm.IsEmpty), Mode=OneWay}">
                    <TextBlock Text="{l:Tr Key=sensors.emptyTitle}" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Center" />
                    <TextBlock Text="{l:Tr Key=sensors.emptyMessage}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" />
                </StackPanel>
                <ProgressRing Grid.Row="1" IsActive="{x:Bind Vm.IsLoading, Mode=OneWay}" Width="24" Height="24" />
            </Grid>
        </Border>
    </Grid>
</Page>
