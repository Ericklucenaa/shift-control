<Page
    x:Class="ShiftControl.App.Views.DriversPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ShiftControl.App.Services"
    xmlns:v="using:ShiftControl.App.Views"
    xmlns:c="using:ShiftControl.App.Controls"
    NavigationCacheMode="Required"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20" MaxWidth="1100" HorizontalAlignment="Left">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="{l:Tr Key=nav.group.hardware, Upper=True}" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="{l:Tr Key=nav.drivers}" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="{l:Tr Key=drivers.subtitle}" Style="{StaticResource CaptionText}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                    <ProgressRing IsActive="{x:Bind Vm.Busy, Mode=OneWay}" Width="16" Height="16" />
                    <Button Style="{StaticResource QuietButton}" Command="{x:Bind Vm.LoadCommand}" IsEnabled="{x:Bind v:ViewHelpers.Not(Vm.Busy), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                            <TextBlock Text="{l:Tr Key=common.refresh}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar IsOpen="{x:Bind v:ViewHelpers.HasText(Vm.Message), Mode=OneWay}" IsClosable="True" Message="{x:Bind Vm.Message, Mode=OneWay}"
                     Severity="{x:Bind v:SettingsPage.StatusSeverity(Vm.MessageIsError), Mode=OneWay}" />
            <c:AdminNotice Text="{l:Tr Key=drivers.adminNotice}" />

            <!-- Placa de vídeo -->
            <StackPanel Spacing="8">
                <TextBlock Text="{l:Tr Key=drivers.gpu}" Style="{StaticResource SectionTitleText}" />
                <TextBlock Text="{l:Tr Key=drivers.gpuHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" />
                <Border Style="{StaticResource CardBorder}" Padding="0">
                    <Grid>
                        <ItemsRepeater ItemsSource="{x:Bind Vm.Gpus}" ItemTemplate="{StaticResource RowTemplate}" />
                        <TextBlock Text="{l:Tr Key=drivers.gpuChecking}" Style="{StaticResource SecondaryText}" Margin="16,14"
                                   Visibility="{x:Bind v:ViewHelpers.Collapsed(Vm.Loaded), Mode=OneWay}" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Problemas -->
            <StackPanel Spacing="8" Visibility="{x:Bind v:ViewHelpers.Visible(Vm.HasProblems), Mode=OneWay}">
                <TextBlock Text="{l:Tr Key=drivers.problems}" Style="{StaticResource SectionTitleText}" />
                <TextBlock Text="{l:Tr Key=drivers.problemsHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" />
                <Border Style="{StaticResource CardBorder}" Padding="0">
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Problems}" ItemTemplate="{StaticResource RowTemplate}" />
                </Border>
            </StackPanel>

            <!-- Windows Update -->
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{l:Tr Key=drivers.wu}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{l:Tr Key=drivers.wuHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                        <ProgressRing IsActive="{x:Bind Vm.Searching, Mode=OneWay}" Width="16" Height="16" />
                        <Button Style="{StaticResource QuietButton}" Content="{l:Tr Key=drivers.wuSearch}" Command="{x:Bind Vm.SearchUpdatesCommand}"
                                IsEnabled="{x:Bind v:ViewHelpers.Not(Vm.Searching), Mode=OneWay}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{x:Bind Vm.UpdatesSummary, Mode=OneWay}" Style="{StaticResource BodyText}" FontWeight="SemiBold"
                           Visibility="{x:Bind v:ViewHelpers.Visible(Vm.Searched), Mode=OneWay}" />
                <Border Style="{StaticResource CardBorder}" Padding="0" Visibility="{x:Bind v:ViewHelpers.Visible(Vm.HasUpdates), Mode=OneWay}">
                    <StackPanel>
                        <ItemsRepeater ItemsSource="{x:Bind Vm.Updates}" ItemTemplate="{StaticResource RowTemplate}" />
                        <Grid Padding="16,12" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:Tr Key=drivers.wuInstallHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <ProgressRing IsActive="{x:Bind Vm.Installing, Mode=OneWay}" Width="16" Height="16" />
                                <Button Style="{StaticResource PrimaryButton}" Click="OnInstall"
                                        Content="{x:Bind v:ViewHelpers.Tr('drivers.wuInstall', Vm.SelectedUpdates), Mode=OneWay}"
                                        IsEnabled="{x:Bind v:ViewHelpers.Not(Vm.Installing), Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Backup e restauração -->
            <StackPanel Spacing="8">
                <TextBlock Text="{l:Tr Key=drivers.backup}" Style="{StaticResource SectionTitleText}" />
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:Tr Key=drivers.backupHint}" Style="{StaticResource SecondaryText}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Style="{StaticResource QuietButton}" Content="{l:Tr Key=drivers.backupCreate}" Click="OnBackup" IsEnabled="{x:Bind v:ViewHelpers.Not(Vm.Busy), Mode=OneWay}" />
                                <Button Style="{StaticResource QuietButton}" Content="{l:Tr Key=drivers.backupRestore}" Click="OnRestore" IsEnabled="{x:Bind v:ViewHelpers.Not(Vm.Busy), Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                        <TextBox Text="{x:Bind Vm.OperationLog, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" MaxHeight="180"
                                 FontFamily="Consolas" FontSize="12" Visibility="{x:Bind v:ViewHelpers.VisibleIfText(Vm.OperationLog), Mode=OneWay}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Inventário -->
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{l:Tr Key=drivers.installed}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{x:Bind Vm.InventorySummary, Mode=OneWay}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Header="{l:Tr Key=drivers.showAll}" IsOn="{x:Bind Vm.ShowAll, Mode=TwoWay}" MinWidth="0" />
                </Grid>
                <Border Style="{StaticResource CardBorder}" Padding="0">
                    <Grid>
                        <ItemsRepeater ItemsSource="{x:Bind Vm.Devices}" ItemTemplate="{StaticResource RowTemplate}" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,14" Visibility="{x:Bind v:ViewHelpers.Collapsed(Vm.Loaded), Mode=OneWay}">
                            <ProgressRing IsActive="True" Width="14" Height="14" />
                            <TextBlock Text="{l:Tr Key=drivers.loading}" Style="{StaticResource SecondaryText}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
