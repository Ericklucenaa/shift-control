<Page
    x:Class="ShiftControl.App.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ShiftControl.App.Services"
    xmlns:v="using:ShiftControl.App.Views"
    NavigationCacheMode="Required"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20" MaxWidth="1100" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="{l:Tr Key=nav.group.maintenance, Upper=True}" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="{l:Tr Key=nav.startup}" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="{l:Tr Key=startup.subtitle}" Style="{StaticResource CaptionText}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource QuietButton}" Content="{l:Tr Key=common.refresh}" Command="{x:Bind Vm.LoadCommand}" VerticalAlignment="Bottom" />
            </Grid>

            <InfoBar IsOpen="{x:Bind v:ViewHelpers.HasText(Vm.Message), Mode=OneWay}" IsClosable="True" Message="{x:Bind Vm.Message, Mode=OneWay}"
                     Severity="{x:Bind v:SettingsPage.StatusSeverity(Vm.MessageIsError), Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind Vm.HasMachineItems, Mode=OneWay}" IsClosable="False" Severity="Informational" Message="{l:Tr Key=startup.machineNotice}" />

            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind Vm.Summary, Mode=OneWay}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                <TextBlock Text="{l:Tr Key=startup.hint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" />
                <Border Style="{StaticResource CardBorder}" Padding="0">
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Items}" ItemTemplate="{StaticResource RowTemplate}" />
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
