<Page
    x:Class="ShiftControl.App.Views.FormatKitPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ShiftControl.App.Services"
    xmlns:vm="using:ShiftControl.App.ViewModels"
    xmlns:v="using:ShiftControl.App.Views"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid x:Name="Root" Padding="32,20,32,0" RowSpacing="16" MaxWidth="1500">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1200" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SideColumn.Width" Value="0" />
                        <Setter Target="SideScroll.(Grid.Column)" Value="0" />
                        <Setter Target="SideScroll.(Grid.Row)" Value="0" />
                        <Setter Target="SideScroll.MaxHeight" Value="320" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel Spacing="16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="{l:Tr Key=nav.group.tools, Upper=True}" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="{l:Tr Key=nav.formatKit}" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="{l:Tr Key=formatKit.subtitle}" Style="{StaticResource CaptionText}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource QuietButton}" Content="{l:Tr Key=formatKit.import}" Click="OnImport" IsEnabled="{x:Bind v:ViewHelpers.Not(Vm.Running), Mode=OneWay}" />
                    <Button Style="{StaticResource QuietButton}" Content="{l:Tr Key=formatKit.export}" Click="OnExport" />
                </StackPanel>
            </Grid>

            <InfoBar Severity="Error" IsClosable="False" IsOpen="{x:Bind Vm.WinGetMissing, Mode=OneWay}"
                     Title="{l:Tr Key=formatKit.wingetMissingTitle}" Message="{l:Tr Key=formatKit.wingetMissing}" />
            <InfoBar Severity="Informational" IsClosable="True" IsOpen="{x:Bind v:ViewHelpers.Not(Vm.IsElevated), Mode=OneWay}"
                     Title="{l:Tr Key=formatKit.uacTitle}" Message="{l:Tr Key=formatKit.uac}" />
            <InfoBar x:Name="KitBar" IsClosable="True" IsOpen="False" />
            <InfoBar Severity="Warning" IsClosable="True" IsOpen="{x:Bind v:ViewHelpers.HasText(Vm.Message), Mode=OneWay}" Message="{x:Bind Vm.Message, Mode=OneWay}" />

            <!-- Perfis -->
            <Grid ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="3">
                    <StackPanel x:Name="ProfileHost" Orientation="Horizontal" Spacing="2" />
                </Border>
                <TextBlock Grid.Column="1" Text="{x:Bind Vm.Summary, Mode=OneWay}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="24" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SideColumn" Width="380" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Catálogo (rolagem própria; o foco num item não arrasta a página) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" BringIntoViewOnFocusChange="False" Padding="0,0,12,0">
                <StackPanel x:Name="Main" Spacing="16" Padding="0,0,0,32">
                    <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{x:Bind v:ViewHelpers.Visible(Vm.Loading), Mode=OneWay}">
                        <ProgressRing IsActive="True" Width="16" Height="16" />
                        <TextBlock Text="{l:Tr Key=formatKit.loading}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Groups}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="16" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:PackageGroup">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind Category}" Style="{StaticResource SectionTitleText}" FontSize="14" />
                                    <Border Style="{StaticResource CardBorder}" Padding="6">
                                        <ItemsRepeater ItemsSource="{x:Bind Items}">
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PackageVm">
                                                    <Grid ColumnSpacing="12" Padding="10,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{x:Bind Selected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Top"
                                                                  AutomationProperties.Name="{x:Bind Name}" />
                                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" />
                                                                <TextBlock Text="{x:Bind SourceText}" Style="{StaticResource CaptionText}" FontSize="11" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None"
                                                                       Visibility="{x:Bind v:ViewHelpers.VisibleIfText(Description)}" />
                                                            <TextBlock Text="{x:Bind Note}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None"
                                                                       Foreground="{ThemeResource AttentionBrush}" Visibility="{x:Bind v:ViewHelpers.Visible(HasNote)}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{x:Bind StatusText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right" MaxWidth="220" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{x:Bind v:ViewHelpers.PackageBrush(Installed, HasUpdate), Mode=OneWay}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                </ScrollViewer>

                <!-- Instalação: sempre visível -->
                <ScrollViewer x:Name="SideScroll" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Side" Spacing="16" Padding="0,0,0,32">
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{l:Tr Key=formatKit.install, Upper=True}" Style="{StaticResource EyebrowText}" />
                            <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Content="{x:Bind Vm.InstallButtonText, Mode=OneWay}"
                                    Command="{x:Bind Vm.InstallSelectedCommand}" IsEnabled="{x:Bind v:FormatKitPage.CanStart(Vm.Running, Vm.ToInstall, Vm.Loading), Mode=OneWay}" />
                            <Button Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" Content="{x:Bind Vm.UpgradeButtonText, Mode=OneWay}"
                                    Command="{x:Bind Vm.UpgradeAllCommand}" IsEnabled="{x:Bind v:FormatKitPage.CanStart(Vm.Running, Vm.ToUpgrade, Vm.Loading), Mode=OneWay}" />
                            <TextBlock Text="{l:Tr Key=formatKit.installHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Visibility="{x:Bind v:ViewHelpers.Visible(Vm.HasJobs), Mode=OneWay}">
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock Text="{l:Tr Key=formatKit.progress, Upper=True}" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Padding="10,4" Content="{l:Tr Key=common.cancel}"
                                        Command="{x:Bind Vm.CancelCommand}" Visibility="{x:Bind v:ViewHelpers.Visible(Vm.Running), Mode=OneWay}" />
                            </Grid>
                            <ItemsRepeater ItemsSource="{x:Bind Vm.Jobs}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="2" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:JobVm">
                                        <Grid ColumnSpacing="10" Padding="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="14" Height="14" VerticalAlignment="Top" Margin="0,3,0,0">
                                                <Ellipse Width="8" Height="8" Fill="{x:Bind v:ViewHelpers.JobBrush(State), Mode=OneWay}"
                                                         Visibility="{x:Bind v:ViewHelpers.Collapsed(Running), Mode=OneWay}" />
                                                <ProgressRing IsActive="{x:Bind Running, Mode=OneWay}" Width="14" Height="14"
                                                              Visibility="{x:Bind v:ViewHelpers.Visible(Running), Mode=OneWay}" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <Grid>
                                                    <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind StateText, Mode=OneWay}" FontSize="12" HorizontalAlignment="Right"
                                                               Foreground="{x:Bind v:ViewHelpers.JobBrush(State), Mode=OneWay}" />
                                                </Grid>
                                                <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None"
                                                           MaxLines="3" Visibility="{x:Bind v:ViewHelpers.VisibleIfText(Detail), Mode=OneWay}" IsTextSelectionEnabled="True" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <TextBlock Text="{x:Bind Vm.ReportText, Mode=OneWay}" Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                       Visibility="{x:Bind v:ViewHelpers.VisibleIfText(Vm.ReportText), Mode=OneWay}" />
                            <InfoBar Severity="Warning" IsClosable="False" IsOpen="{x:Bind Vm.RebootRequired, Mode=OneWay}" Message="{l:Tr Key=formatKit.reboot}" />
                            <Button Style="{StaticResource QuietButton}" Content="{l:Tr Key=formatKit.retry}" Command="{x:Bind Vm.RetryFailedCommand}"
                                    Visibility="{x:Bind v:FormatKitPage.ShowRetry(Vm.HasFailures, Vm.Running), Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Grid>
    </Grid>
</Page>
