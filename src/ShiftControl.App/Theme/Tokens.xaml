<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Design tokens do Shift Control.
        Superfícies em grafite neutro (sem tom azulado), bordas finas e um único acento configurável.
        O acento (AccentBrush e derivados) é criado em código pelo ThemeService para mudar em tempo real.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="AppBackgroundColor">#101112</Color>
            <Color x:Key="SidebarBackgroundColor">#0C0D0E</Color>
            <Color x:Key="CardBackgroundColor">#17181A</Color>
            <Color x:Key="CardBorderColor">#232528</Color>
            <Color x:Key="RaisedBackgroundColor">#1E2023</Color>
            <Color x:Key="HoverBackgroundColor">#25272A</Color>
            <Color x:Key="TextPrimaryColor">#ECEDEE</Color>
            <Color x:Key="TextSecondaryColor">#A0A4AA</Color>
            <Color x:Key="TextTertiaryColor">#6F747B</Color>
            <Color x:Key="MeterTrackColor">#26282B</Color>
            <Color x:Key="GridLineColor">#202225</Color>
            <Color x:Key="GoodColor">#4FB286</Color>
            <Color x:Key="AttentionColor">#E3A83B</Color>
            <Color x:Key="CriticalColor">#E5534B</Color>
            <Color x:Key="SecondarySeriesColor">#9AA0A6</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{ThemeResource SidebarBackgroundColor}" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{ThemeResource CardBackgroundColor}" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="{ThemeResource CardBorderColor}" />
            <SolidColorBrush x:Key="RaisedBackgroundBrush" Color="{ThemeResource RaisedBackgroundColor}" />
            <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{ThemeResource HoverBackgroundColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource TextTertiaryColor}" />
            <SolidColorBrush x:Key="MeterTrackBrush" Color="{ThemeResource MeterTrackColor}" />
            <SolidColorBrush x:Key="GridLineBrush" Color="{ThemeResource GridLineColor}" />
            <SolidColorBrush x:Key="GoodBrush" Color="{ThemeResource GoodColor}" />
            <SolidColorBrush x:Key="AttentionBrush" Color="{ThemeResource AttentionColor}" />
            <SolidColorBrush x:Key="CriticalBrush" Color="{ThemeResource CriticalColor}" />
            <SolidColorBrush x:Key="SecondarySeriesBrush" Color="{ThemeResource SecondarySeriesColor}" />
            <SolidColorBrush x:Key="QuietButtonBackgroundBrush" Color="{ThemeResource RaisedBackgroundColor}" />
            <SolidColorBrush x:Key="QuietButtonBorderBrush" Color="{ThemeResource CardBorderColor}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="AppBackgroundColor">#F3F4F5</Color>
            <Color x:Key="SidebarBackgroundColor">#ECEEF0</Color>
            <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
            <Color x:Key="CardBorderColor">#DFE2E5</Color>
            <Color x:Key="RaisedBackgroundColor">#F7F8F9</Color>
            <Color x:Key="HoverBackgroundColor">#EEF0F2</Color>
            <Color x:Key="TextPrimaryColor">#15171A</Color>
            <Color x:Key="TextSecondaryColor">#555B62</Color>
            <Color x:Key="TextTertiaryColor">#80868D</Color>
            <Color x:Key="MeterTrackColor">#E4E7EA</Color>
            <Color x:Key="GridLineColor">#ECEEF0</Color>
            <Color x:Key="GoodColor">#2E8B62</Color>
            <Color x:Key="AttentionColor">#B7791F</Color>
            <Color x:Key="CriticalColor">#C93C35</Color>
            <Color x:Key="SecondarySeriesColor">#7A8088</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{ThemeResource SidebarBackgroundColor}" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{ThemeResource CardBackgroundColor}" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="{ThemeResource CardBorderColor}" />
            <SolidColorBrush x:Key="RaisedBackgroundBrush" Color="{ThemeResource RaisedBackgroundColor}" />
            <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{ThemeResource HoverBackgroundColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource TextTertiaryColor}" />
            <SolidColorBrush x:Key="MeterTrackBrush" Color="{ThemeResource MeterTrackColor}" />
            <SolidColorBrush x:Key="GridLineBrush" Color="{ThemeResource GridLineColor}" />
            <SolidColorBrush x:Key="GoodBrush" Color="{ThemeResource GoodColor}" />
            <SolidColorBrush x:Key="AttentionBrush" Color="{ThemeResource AttentionColor}" />
            <SolidColorBrush x:Key="CriticalBrush" Color="{ThemeResource CriticalColor}" />
            <SolidColorBrush x:Key="SecondarySeriesBrush" Color="{ThemeResource SecondarySeriesColor}" />
            <SolidColorBrush x:Key="QuietButtonBackgroundBrush" Color="{ThemeResource RaisedBackgroundColor}" />
            <SolidColorBrush x:Key="QuietButtonBorderBrush" Color="{ThemeResource CardBorderColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Espaçamento (escala de 4) -->
    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space6">24</x:Double>
    <x:Double x:Key="Space8">32</x:Double>
    <Thickness x:Key="PagePadding">32,20,32,40</Thickness>
    <Thickness x:Key="CardPadding">20,18,20,20</Thickness>

    <!-- Raios: cartões discretos, controles menores -->
    <CornerRadius x:Key="CardRadius">8</CornerRadius>
    <CornerRadius x:Key="ControlRadius">5</CornerRadius>
    <CornerRadius x:Key="PillRadius">11</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">5</CornerRadius>
    <Thickness x:Key="QuietButtonBorderThickness">1</Thickness>
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="Transparent" />

    <!-- Tipografia -->
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
</ResourceDictionary>
