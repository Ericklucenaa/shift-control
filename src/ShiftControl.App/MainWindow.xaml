<Window
    x:Class="ShiftControl.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ShiftControl.App.Services"
    Title="Shift Control">

    <Grid x:Name="Root" Background="{ThemeResource SidebarBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="OnAccelerator" />
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="OnAccelerator" />
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="OnAccelerator" />
            <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="OnAccelerator" />
            <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="OnAccelerator" />
            <KeyboardAccelerator Key="Number6" Modifiers="Control" Invoked="OnAccelerator" />
            <KeyboardAccelerator Key="Number7" Modifiers="Control" Invoked="OnAccelerator" />
            <KeyboardAccelerator Key="Number8" Modifiers="Control" Invoked="OnAccelerator" />
            <KeyboardAccelerator Key="Number9" Modifiers="Control" Invoked="OnAccelerator" />
        </Grid.KeyboardAccelerators>

        <!-- Barra de título própria (área arrastável) -->
        <Grid x:Name="TitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon-32.png" Width="16" Height="16" />
                <TextBlock Text="Shift Control" FontSize="12" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <Border x:Name="AdminTag" Style="{StaticResource TagBorder}" Visibility="Collapsed">
                    <TextBlock Text="{l:Tr Key=shell.adminTag}" Style="{StaticResource TagText}" FontSize="10" />
                </Border>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="FaultBar" Grid.Row="1" Severity="Error" IsClosable="False" IsOpen="False"
                 Title="{l:Tr Key=shell.faultTitle}" Message="{l:Tr Key=shell.faultMessage}" Margin="12,0,12,8">
            <InfoBar.ActionButton>
                <Button Content="{l:Tr Key=settings.openLogs}" Click="OnOpenLogs" />
            </InfoBar.ActionButton>
        </InfoBar>

        <NavigationView x:Name="Nav" Grid.Row="2"
                        PaneDisplayMode="Auto"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="270"
                        CompactModeThresholdWidth="700"
                        ExpandedModeThresholdWidth="1000"
                        SelectionChanged="OnNavSelectionChanged"
                        PaneOpened="OnPaneToggled"
                        PaneClosed="OnPaneToggled">
            <NavigationView.Resources>
                <ResourceDictionary>
                    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">8,0,0,0</CornerRadius>
                    <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
                </ResourceDictionary>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="{l:Tr Key=nav.group.dashboard}" Tag="dashboard" />
                <NavigationViewItem Content="{l:Tr Key=nav.overview}" Tag="overview" ToolTipService.ToolTip="Ctrl+1">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{l:Tr Key=nav.history}" Tag="history" ToolTipService.ToolTip="Ctrl+2">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="{l:Tr Key=nav.group.hardware}" Tag="hardware" />
                <NavigationViewItem Content="{l:Tr Key=nav.components}" Tag="components">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE770;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{l:Tr Key=nav.sensors}" Tag="sensors" ToolTipService.ToolTip="Ctrl+3">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9CA;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{l:Tr Key=nav.drivers}" Tag="drivers" ToolTipService.ToolTip="Ctrl+4">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE950;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{l:Tr Key=nav.disks}" Tag="disks" ToolTipService.ToolTip="Ctrl+5">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDA2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="{l:Tr Key=nav.group.gaming}" Tag="gaming" />
                <NavigationViewItem Content="{l:Tr Key=nav.overlay}" Tag="overlay" ToolTipService.ToolTip="Ctrl+6">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{l:Tr Key=nav.sessions}" Tag="sessions" ToolTipService.ToolTip="Ctrl+7">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{l:Tr Key=nav.boost}" Tag="boost" ToolTipService.ToolTip="Ctrl+8">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="{l:Tr Key=nav.group.tools}" Tag="tools" />
                <NavigationViewItem Content="{l:Tr Key=nav.formatKit}" Tag="formatkit" ToolTipService.ToolTip="Ctrl+9">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{l:Tr Key=nav.migration}" Tag="migration">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{l:Tr Key=nav.checks}" Tag="checks">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="{l:Tr Key=nav.group.maintenance}" Tag="maintenance" />
                <NavigationViewItem Content="{l:Tr Key=nav.cleanup}" Tag="cleanup">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA99;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{l:Tr Key=nav.startup}" Tag="startup">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{l:Tr Key=nav.repair}" Tag="repair">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{l:Tr Key=nav.network}" Tag="network">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="{l:Tr Key=nav.group.system}" Tag="system" />
                <NavigationViewItem Content="{l:Tr Key=nav.tasks}" Tag="tasks">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{l:Tr Key=nav.programs}" Tag="programs">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE71D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{l:Tr Key=nav.alerts}" Tag="alerts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA8F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{l:Tr Key=nav.undo}" Tag="undo">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7A7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{l:Tr Key=nav.settings}" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" IsNavigationStackEnabled="False" />
        </NavigationView>
    </Grid>
</Window>
